{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vscode", "react", "react-dom"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "src",
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "unstableApiUsage": "off",
          "schemaClassMissingBrand": "off"
        }
      }
    ]
  },
  "include": ["src"]
}
