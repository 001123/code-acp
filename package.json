{
  "name": "code-acp",
  "displayName": "Code ACP",
  "description": "%description%",
  "version": "0.0.1",
  "publisher": "001123",
  "icon": "media/extension-icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/001123/code-acp"
  },
  "engines": {
    "vscode": "^1.123.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces%"
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "codeAcp",
          "title": "Code ACP",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codeAcp": [
        {
          "type": "webview",
          "id": "codeAcp.chat",
          "name": "%view.chat%",
          "icon": "media/icon.svg",
          "initialSize": 10
        },
        {
          "id": "codeAcp.drop",
          "name": "%view.drop%",
          "icon": "media/icon.svg",
          "initialSize": 1
        }
      ]
    },
    "commands": [
      {
        "command": "codeAcp.manageAgents",
        "title": "%command.manageAgents%",
        "category": "%command.category%",
        "icon": "$(extensions)"
      },
      {
        "command": "codeAcp.selectAgent",
        "title": "%command.selectAgent%",
        "category": "%command.category%"
      },
      {
        "command": "codeAcp.newSession",
        "title": "%command.newSession%",
        "icon": "$(add)"
      },
      {
        "command": "codeAcp.history",
        "title": "%command.history%",
        "category": "%command.category%",
        "icon": "$(history)"
      },
      {
        "command": "codeAcp.cancel",
        "title": "%command.cancel%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "codeAcp.worktree",
        "title": "%command.worktree%",
        "category": "%command.category%"
      },
      {
        "command": "codeAcp.cleanWorktrees",
        "title": "%command.cleanWorktrees%",
        "category": "%command.category%"
      },
      {
        "command": "codeAcp.tabWorktree",
        "title": "%command.tabWorktree%"
      },
      {
        "command": "codeAcp.login",
        "title": "%command.login%",
        "category": "%command.category%"
      },
      {
        "command": "codeAcp.logout",
        "title": "%command.logout%",
        "category": "%command.category%"
      },
      {
        "command": "codeAcp.restart",
        "title": "%command.restart%",
        "category": "%command.category%"
      },
      {
        "command": "codeAcp.showLog",
        "title": "%command.showLog%",
        "category": "%command.category%"
      },
      {
        "command": "codeAcp.showTrace",
        "title": "%command.showTrace%",
        "category": "%command.category%"
      },
      {
        "command": "codeAcp.doctor",
        "title": "%command.doctor%",
        "category": "%command.category%"
      },
      {
        "command": "codeAcp.openWalkthrough",
        "title": "%command.openWalkthrough%",
        "category": "%command.category%"
      },
      {
        "command": "codeAcp.attach",
        "title": "%command.attach%",
        "icon": "$(attach)"
      },
      {
        "command": "codeAcp.openSettings",
        "title": "%command.openSettings%",
        "category": "%command.category%",
        "icon": "$(gear)"
      },
      {
        "command": "codeAcp.generateCommitMessage",
        "title": "%command.generateCommitMessage%",
        "icon": "$(sparkle)",
        "enablement": "!codeAcp.generatingCommitMessage"
      },
      {
        "command": "codeAcp.cancelCommitMessage",
        "title": "%command.cancelCommitMessage%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "codeAcp.commitAndPush",
        "title": "%command.commitAndPush%",
        "icon": "$(cloud-upload)",
        "enablement": "!codeAcp.generatingCommitMessage"
      },
      {
        "command": "codeAcp.addSelection",
        "title": "%command.addSelection%"
      },
      {
        "command": "codeAcp.addTerminalSelection",
        "title": "%command.addTerminalSelection%"
      },
      {
        "command": "codeAcp.addTerminalOutput",
        "title": "%command.addTerminalOutput%"
      },
      {
        "command": "codeAcp.addTerminalFailure",
        "title": "%command.addTerminalFailure%"
      },
      {
        "command": "codeAcp.quoteSelection",
        "title": "%command.quoteSelection%"
      },
      {
        "command": "codeAcp.pinTab",
        "title": "%command.pinTab%"
      },
      {
        "command": "codeAcp.unpinTab",
        "title": "%command.unpinTab%"
      },
      {
        "command": "codeAcp.renameTab",
        "title": "%command.renameTab%"
      },
      {
        "command": "codeAcp.closeTab",
        "title": "%command.closeTab%"
      },
      {
        "command": "codeAcp.closeOtherTabs",
        "title": "%command.closeOtherTabs%"
      },
      {
        "command": "codeAcp.closeTabsToRight",
        "title": "%command.closeTabsToRight%"
      },
      {
        "command": "codeAcp.forkTab",
        "title": "%command.forkTab%"
      },
      {
        "command": "codeAcp.addProblems",
        "title": "%command.addProblems%"
      },
      {
        "command": "codeAcp.showUsage",
        "title": "%command.showUsage%",
        "category": "%command.category%"
      },
      {
        "command": "codeAcp.showAttention",
        "title": "%command.showAttention%"
      },
      {
        "command": "codeAcp.addWorkspaceProblems",
        "title": "%command.addWorkspaceProblems%"
      },
      {
        "command": "codeAcp.fixProblems",
        "title": "%command.fixProblems%"
      },
      {
        "command": "codeAcp.explainSelection",
        "title": "%command.explainSelection%",
        "category": "%command.category%"
      },
      {
        "command": "codeAcp.refactorSelection",
        "title": "%command.refactorSelection%",
        "category": "%command.category%"
      },
      {
        "command": "codeAcp.testSelection",
        "title": "%command.testSelection%",
        "category": "%command.category%"
      }
    ],
    "submenus": [
      {
        "id": "codeAcp.ask",
        "label": "%submenu.ask%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codeAcp.history",
          "when": "view == codeAcp.chat",
          "group": "navigation@1"
        },
        {
          "command": "codeAcp.manageAgents",
          "when": "view == codeAcp.chat",
          "group": "navigation@2"
        },
        {
          "command": "codeAcp.selectAgent",
          "when": "view == codeAcp.chat",
          "group": "1_agent@1"
        },
        {
          "command": "codeAcp.worktree",
          "when": "view == codeAcp.chat",
          "group": "1_agent@5"
        },
        {
          "command": "codeAcp.cleanWorktrees",
          "when": "view == codeAcp.chat",
          "group": "1_agent@6"
        },
        {
          "command": "codeAcp.login",
          "when": "view == codeAcp.chat",
          "group": "1_agent@2"
        },
        {
          "command": "codeAcp.logout",
          "when": "view == codeAcp.chat",
          "group": "1_agent@3"
        },
        {
          "command": "codeAcp.restart",
          "when": "view == codeAcp.chat",
          "group": "1_agent@4"
        },
        {
          "command": "codeAcp.showUsage",
          "when": "view == codeAcp.chat",
          "group": "2_info@1"
        },
        {
          "command": "codeAcp.showLog",
          "when": "view == codeAcp.chat",
          "group": "2_info@2"
        },
        {
          "command": "codeAcp.showTrace",
          "when": "view == codeAcp.chat && config.codeAcp.tracing",
          "group": "2_info@3"
        },
        {
          "command": "codeAcp.doctor",
          "when": "view == codeAcp.chat",
          "group": "2_info@4"
        },
        {
          "command": "codeAcp.openWalkthrough",
          "when": "view == codeAcp.chat",
          "group": "2_info@5"
        },
        {
          "command": "codeAcp.openSettings",
          "when": "view == codeAcp.chat",
          "group": "3_settings@1"
        }
      ],
      "explorer/context": [
        {
          "command": "codeAcp.attach",
          "group": "codeAcp@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "codeAcp.attach",
          "when": "resourceScheme == file",
          "group": "codeAcp@1"
        }
      ],
      "editor/context": [
        {
          "command": "codeAcp.addSelection",
          "when": "editorHasSelection",
          "group": "codeAcp@0"
        },
        {
          "submenu": "codeAcp.ask",
          "when": "editorHasSelection",
          "group": "codeAcp@0"
        },
        {
          "command": "codeAcp.attach",
          "when": "resourceScheme == file",
          "group": "codeAcp@1"
        },
        {
          "command": "codeAcp.addProblems",
          "when": "resourceScheme == file",
          "group": "codeAcp@2"
        }
      ],
      "terminal/context": [
        {
          "command": "codeAcp.addTerminalSelection",
          "when": "terminalTextSelected",
          "group": "codeAcp@0"
        },
        {
          "command": "codeAcp.addTerminalOutput",
          "group": "codeAcp@1"
        },
        {
          "command": "codeAcp.addTerminalFailure",
          "group": "codeAcp@2"
        }
      ],
      "scm/title": [
        {
          "command": "codeAcp.generateCommitMessage",
          "when": "scmProvider == git && !codeAcp.generatingCommitMessage",
          "group": "navigation@1"
        },
        {
          "command": "codeAcp.cancelCommitMessage",
          "when": "scmProvider == git && codeAcp.generatingCommitMessage",
          "group": "navigation@1"
        },
        {
          "command": "codeAcp.commitAndPush",
          "when": "scmProvider == git",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "codeAcp.cancelCommitMessage",
          "when": "codeAcp.generatingCommitMessage"
        },
        {
          "command": "codeAcp.quoteSelection",
          "when": "false"
        },
        {
          "command": "codeAcp.pinTab",
          "when": "false"
        },
        {
          "command": "codeAcp.unpinTab",
          "when": "false"
        },
        {
          "command": "codeAcp.renameTab",
          "when": "false"
        },
        {
          "command": "codeAcp.closeTab",
          "when": "false"
        },
        {
          "command": "codeAcp.closeOtherTabs",
          "when": "false"
        },
        {
          "command": "codeAcp.closeTabsToRight",
          "when": "false"
        },
        {
          "command": "codeAcp.forkTab",
          "when": "false"
        },
        {
          "command": "codeAcp.tabWorktree",
          "when": "false"
        },
        {
          "command": "codeAcp.fixProblems",
          "when": "false"
        },
        {
          "command": "codeAcp.explainSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "codeAcp.refactorSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "codeAcp.testSelection",
          "when": "editorHasSelection"
        }
      ],
      "codeAcp.ask": [
        {
          "command": "codeAcp.explainSelection",
          "group": "ask@0"
        },
        {
          "command": "codeAcp.refactorSelection",
          "group": "ask@1"
        },
        {
          "command": "codeAcp.testSelection",
          "group": "ask@2"
        }
      ],
      "webview/context": [
        {
          "command": "codeAcp.quoteSelection",
          "when": "webviewId == 'codeAcp.chat' && webviewSection == 'messages' && selectedText",
          "group": "codeAcp@1"
        },
        {
          "command": "codeAcp.pinTab",
          "when": "webviewId == 'codeAcp.chat' && webviewSection == 'tab' && !tabPinned",
          "group": "1_pin@1"
        },
        {
          "command": "codeAcp.unpinTab",
          "when": "webviewId == 'codeAcp.chat' && webviewSection == 'tab' && tabPinned",
          "group": "1_pin@1"
        },
        {
          "command": "codeAcp.renameTab",
          "when": "webviewId == 'codeAcp.chat' && webviewSection == 'tab'",
          "group": "1_pin@3"
        },
        {
          "command": "codeAcp.closeTab",
          "when": "webviewId == 'codeAcp.chat' && webviewSection == 'tab' && !tabPinned",
          "group": "2_close@1"
        },
        {
          "command": "codeAcp.closeOtherTabs",
          "when": "webviewId == 'codeAcp.chat' && webviewSection == 'tab'",
          "group": "2_close@2"
        },
        {
          "command": "codeAcp.closeTabsToRight",
          "when": "webviewId == 'codeAcp.chat' && webviewSection == 'tab'",
          "group": "2_close@3"
        },
        {
          "command": "codeAcp.forkTab",
          "when": "webviewId == 'codeAcp.chat' && webviewSection == 'tab' && tabCanFork",
          "group": "1_pin@2"
        },
        {
          "command": "codeAcp.tabWorktree",
          "when": "webviewId == 'codeAcp.chat' && webviewSection == 'tab'",
          "group": "1_pin@4"
        }
      ]
    },
    "configuration": {
      "title": "Code ACP",
      "properties": {
        "codeAcp.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "vi"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "English",
            "Tiếng Việt"
          ],
          "default": "auto",
          "description": "%config.language%"
        },
        "codeAcp.customAgents": {
          "scope": "machine",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "command"
            ]
          },
          "default": {},
          "description": "%config.customAgents%"
        },
        "codeAcp.env": {
          "scope": "machine",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "%config.env%"
        },
        "codeAcp.nodePath": {
          "scope": "machine",
          "type": "string",
          "default": "node",
          "description": "%config.nodePath%"
        },
        "codeAcp.ccusagePath": {
          "scope": "machine",
          "type": "string",
          "default": "",
          "description": "%config.ccusagePath%"
        },
        "codeAcp.checkAgentUpdates": {
          "type": "boolean",
          "default": true,
          "description": "%config.checkAgentUpdates%"
        },
        "codeAcp.followAgent": {
          "type": "boolean",
          "default": false,
          "description": "%config.followAgent%"
        },
        "codeAcp.autoScroll": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoScroll%"
        },
        "codeAcp.showChanges": {
          "type": "boolean",
          "default": true,
          "description": "%config.showChanges%"
        },
        "codeAcp.showRestore": {
          "type": "boolean",
          "default": false,
          "description": "%config.showRestore%"
        },
        "codeAcp.tracing": {
          "type": "boolean",
          "default": false,
          "description": "%config.tracing%"
        },
        "codeAcp.notifications": {
          "type": "boolean",
          "default": true,
          "description": "%config.notifications%"
        },
        "codeAcp.notifyFinished": {
          "type": "boolean",
          "default": true,
          "description": "%config.notifyFinished%"
        },
        "codeAcp.rememberSessionOptions": {
          "type": "boolean",
          "default": true,
          "description": "%config.rememberSessionOptions%"
        },
        "codeAcp.sessionDefaults": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string"
              },
              "effort": {
                "type": "string"
              },
              "fastMode": {
                "type": "string",
                "enum": [
                  "default",
                  "on",
                  "off"
                ]
              }
            },
            "additionalProperties": false
          },
          "description": "%config.sessionDefaults%"
        },
        "codeAcp.worktreeForNewTabs": {
          "type": "boolean",
          "default": false,
          "description": "%config.worktreeForNewTabs%"
        },
        "codeAcp.worktreeCopyFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.worktreeCopyFiles%"
        },
        "codeAcp.worktreeSetupCommand": {
          "scope": "machine",
          "type": "string",
          "default": "",
          "description": "%config.worktreeSetupCommand%"
        },
        "codeAcp.worktreeProjectSetupCommand": {
          "scope": "resource",
          "type": "string",
          "default": "",
          "description": "%config.worktreeProjectSetupCommand%"
        },
        "codeAcp.commitMessage.agent": {
          "type": "string",
          "default": "",
          "description": "%config.commitMessage.agent%"
        },
        "codeAcp.commitMessage.model": {
          "type": "string",
          "default": "",
          "description": "%config.commitMessage.model%"
        },
        "codeAcp.commitMessage.effort": {
          "type": "string",
          "default": "lowest",
          "description": "%config.commitMessage.effort%"
        },
        "codeAcp.commitMessage.fastMode": {
          "type": "string",
          "enum": [
            "default",
            "on",
            "off"
          ],
          "default": "default",
          "description": "%config.commitMessage.fastMode%"
        },
        "codeAcp.commitMessage.instructions": {
          "type": "string",
          "default": "Use Conventional Commits: type(scope): subject, where type is feat, fix, docs, style, refactor, perf, test, build, ci or chore and the scope is optional. Write a single subject line only, no body.",
          "editPresentation": "multilineText",
          "description": "%config.commitMessage.instructions%"
        },
        "codeAcp.allowedHttpHosts": {
          "scope": "machine",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.allowedHttpHosts%"
        },
        "codeAcp.autoApprove": {
          "scope": "machine",
          "type": "object",
          "default": {},
          "additionalProperties": false,
          "description": "%config.autoApprove%",
          "properties": {
            "read": {
              "type": "string",
              "enum": ["ask", "allow"],
              "description": "%config.autoApprove.read%"
            },
            "edit": {
              "type": "string",
              "enum": ["ask", "allow"],
              "description": "%config.autoApprove.edit%"
            },
            "execute": {
              "type": "string",
              "enum": ["ask", "allow"],
              "description": "%config.autoApprove.execute%"
            },
            "fetch": {
              "type": "string",
              "enum": ["ask", "allow"],
              "description": "%config.autoApprove.fetch%"
            },
            "worktreeTabs": {
              "type": "string",
              "enum": ["ask", "allow"],
              "description": "%config.autoApprove.worktreeTabs%"
            }
          }
        },
        "codeAcp.mcpServers": {
          "scope": "machine",
          "type": "object",
          "default": {},
          "markdownDescription": "%config.mcpServers%",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "stdio",
                  "http",
                  "sse"
                ],
                "default": "stdio"
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "url": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "install",
            "title": "%walkthrough.install.title%",
            "description": "%walkthrough.install.description%",
            "media": {
              "svg": "media/walkthrough/install.svg",
              "altText": "%walkthrough.install.alt%"
            },
            "completionEvents": [
              "onContext:codeAcp.hasAgent"
            ]
          },
          {
            "id": "doctor",
            "title": "%walkthrough.doctor.title%",
            "description": "%walkthrough.doctor.description%",
            "media": {
              "svg": "media/walkthrough/doctor.svg",
              "altText": "%walkthrough.doctor.alt%"
            },
            "completionEvents": [
              "onCommand:codeAcp.doctor"
            ]
          },
          {
            "id": "chat",
            "title": "%walkthrough.chat.title%",
            "description": "%walkthrough.chat.description%",
            "media": {
              "svg": "media/walkthrough/chat.svg",
              "altText": "%walkthrough.chat.alt%"
            },
            "completionEvents": [
              "onView:codeAcp.chat"
            ]
          },
          {
            "id": "parallel",
            "title": "%walkthrough.parallel.title%",
            "description": "%walkthrough.parallel.description%",
            "media": {
              "svg": "media/walkthrough/parallel.svg",
              "altText": "%walkthrough.parallel.alt%"
            },
            "completionEvents": [
              "onCommand:codeAcp.openSettings"
            ]
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "codeAcp.chat.focus",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "codeAcp.newSession",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "focusedView == 'codeAcp.chat'"
      },
      {
        "command": "codeAcp.cancel",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "focusedView == 'codeAcp.chat'"
      },
      {
        "command": "codeAcp.addSelection",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "codeAcp.addTerminalSelection",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "terminalFocus && terminalTextSelected"
      },
      {
        "command": "codeAcp.addProblems",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
