{
  "name": "kd-code",
  "displayName": "KD Code",
  "description": "%description%",
  "version": "0.0.1",
  "publisher": "kd-labs",
  "icon": "media/extension-icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/001123/code-acp"
  },
  "engines": {
    "vscode": "^1.123.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces%"
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:kdCode.settings",
    "onWebviewPanel:kdCode.diagram"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "kdCode",
          "title": "KD Code",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "kdCode": [
        {
          "type": "webview",
          "id": "kdCode.chat",
          "name": "%view.chat%",
          "icon": "media/icon.svg",
          "initialSize": 10
        },
        {
          "id": "kdCode.drop",
          "name": "%view.drop%",
          "when": "kdCode.hasAgent",
          "icon": "media/icon.svg",
          "initialSize": 1
        }
      ]
    },
    "commands": [
      {
        "command": "kdCode.manageAgents",
        "title": "%command.manageAgents%",
        "category": "%command.category%",
        "icon": "$(extensions)"
      },
      {
        "command": "kdCode.selectAgent",
        "title": "%command.selectAgent%",
        "category": "%command.category%"
      },
      {
        "command": "kdCode.newSession",
        "title": "%command.newSession%",
        "icon": "$(add)"
      },
      {
        "command": "kdCode.history",
        "title": "%command.history%",
        "category": "%command.category%",
        "icon": "$(history)"
      },
      {
        "command": "kdCode.findInConversation",
        "title": "%command.findInConversation%",
        "category": "%command.category%",
        "icon": "$(search)"
      },
      {
        "command": "kdCode.exportConversation",
        "title": "%command.exportConversation%",
        "category": "%command.category%"
      },
      {
        "command": "kdCode.exportTab",
        "title": "%command.exportTab%"
      },
      {
        "command": "kdCode.cancel",
        "title": "%command.cancel%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "kdCode.worktree",
        "title": "%command.worktree%",
        "category": "%command.category%"
      },
      {
        "command": "kdCode.cleanWorktrees",
        "title": "%command.cleanWorktrees%",
        "category": "%command.category%"
      },
      {
        "command": "kdCode.tabWorktree",
        "title": "%command.tabWorktree%"
      },
      {
        "command": "kdCode.login",
        "title": "%command.login%",
        "category": "%command.category%"
      },
      {
        "command": "kdCode.logout",
        "title": "%command.logout%",
        "category": "%command.category%"
      },
      {
        "command": "kdCode.restart",
        "title": "%command.restart%",
        "category": "%command.category%"
      },
      {
        "command": "kdCode.showLog",
        "title": "%command.showLog%",
        "category": "%command.category%"
      },
      {
        "command": "kdCode.showTrace",
        "title": "%command.showTrace%",
        "category": "%command.category%"
      },
      {
        "command": "kdCode.doctor",
        "title": "%command.doctor%",
        "category": "%command.category%"
      },
      {
        "command": "kdCode.openWalkthrough",
        "title": "%command.openWalkthrough%",
        "category": "%command.category%"
      },
      {
        "command": "kdCode.attach",
        "title": "%command.attach%",
        "icon": "$(attach)"
      },
      {
        "command": "kdCode.openSettings",
        "title": "%command.openSettings%",
        "category": "%command.category%",
        "icon": "$(gear)"
      },
      {
        "command": "kdCode.generateCommitMessage",
        "title": "%command.generateCommitMessage%",
        "icon": "$(sparkle)",
        "enablement": "!kdCode.generatingCommitMessage"
      },
      {
        "command": "kdCode.cancelCommitMessage",
        "title": "%command.cancelCommitMessage%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "kdCode.commitAndPush",
        "title": "%command.commitAndPush%",
        "icon": "$(cloud-upload)",
        "enablement": "!kdCode.generatingCommitMessage"
      },
      {
        "command": "kdCode.addSelection",
        "title": "%command.addSelection%"
      },
      {
        "command": "kdCode.addTerminalSelection",
        "title": "%command.addTerminalSelection%"
      },
      {
        "command": "kdCode.addTerminalOutput",
        "title": "%command.addTerminalOutput%"
      },
      {
        "command": "kdCode.addTerminalFailure",
        "title": "%command.addTerminalFailure%"
      },
      {
        "command": "kdCode.quoteSelection",
        "title": "%command.quoteSelection%"
      },
      {
        "command": "kdCode.pinTab",
        "title": "%command.pinTab%"
      },
      {
        "command": "kdCode.unpinTab",
        "title": "%command.unpinTab%"
      },
      {
        "command": "kdCode.renameTab",
        "title": "%command.renameTab%"
      },
      {
        "command": "kdCode.closeTab",
        "title": "%command.closeTab%"
      },
      {
        "command": "kdCode.closeOtherTabs",
        "title": "%command.closeOtherTabs%"
      },
      {
        "command": "kdCode.closeTabsBelow",
        "title": "%command.closeTabsBelow%"
      },
      {
        "command": "kdCode.forkTab",
        "title": "%command.forkTab%"
      },
      {
        "command": "kdCode.addProblems",
        "title": "%command.addProblems%"
      },
      {
        "command": "kdCode.showUsage",
        "title": "%command.showUsage%",
        "category": "%command.category%"
      },
      {
        "command": "kdCode.showAttention",
        "title": "%command.showAttention%"
      },
      {
        "command": "kdCode.addWorkspaceProblems",
        "title": "%command.addWorkspaceProblems%"
      },
      {
        "command": "kdCode.fixProblems",
        "title": "%command.fixProblems%"
      },
      {
        "command": "kdCode.explainSelection",
        "title": "%command.explainSelection%",
        "category": "%command.category%"
      },
      {
        "command": "kdCode.refactorSelection",
        "title": "%command.refactorSelection%",
        "category": "%command.category%"
      },
      {
        "command": "kdCode.testSelection",
        "title": "%command.testSelection%",
        "category": "%command.category%"
      }
    ],
    "submenus": [
      {
        "id": "kdCode.ask",
        "label": "%submenu.ask%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kdCode.findInConversation",
          "when": "view == kdCode.chat",
          "group": "navigation@0"
        },
        {
          "command": "kdCode.history",
          "when": "view == kdCode.chat",
          "group": "navigation@1"
        },
        {
          "command": "kdCode.manageAgents",
          "when": "view == kdCode.chat",
          "group": "navigation@2"
        },
        {
          "command": "kdCode.login",
          "when": "view == kdCode.chat",
          "group": "1_agent@1"
        },
        {
          "command": "kdCode.logout",
          "when": "view == kdCode.chat",
          "group": "1_agent@2"
        },
        {
          "command": "kdCode.restart",
          "when": "view == kdCode.chat",
          "group": "1_agent@3"
        },
        {
          "command": "kdCode.exportConversation",
          "when": "view == kdCode.chat",
          "group": "2_tools@0"
        },
        {
          "command": "kdCode.showLog",
          "when": "view == kdCode.chat",
          "group": "2_tools@1"
        },
        {
          "command": "kdCode.openSettings",
          "when": "view == kdCode.chat",
          "group": "3_settings@1"
        }
      ],
      "explorer/context": [
        {
          "command": "kdCode.attach",
          "group": "kdCode@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "kdCode.attach",
          "when": "resourceScheme == file",
          "group": "kdCode@1"
        }
      ],
      "editor/context": [
        {
          "command": "kdCode.addSelection",
          "when": "editorHasSelection",
          "group": "kdCode@0"
        },
        {
          "submenu": "kdCode.ask",
          "when": "editorHasSelection",
          "group": "kdCode@0"
        },
        {
          "command": "kdCode.attach",
          "when": "resourceScheme == file",
          "group": "kdCode@1"
        },
        {
          "command": "kdCode.addProblems",
          "when": "resourceScheme == file",
          "group": "kdCode@2"
        }
      ],
      "terminal/context": [
        {
          "command": "kdCode.addTerminalSelection",
          "when": "terminalTextSelected",
          "group": "kdCode@0"
        },
        {
          "command": "kdCode.addTerminalOutput",
          "group": "kdCode@1"
        },
        {
          "command": "kdCode.addTerminalFailure",
          "group": "kdCode@2"
        }
      ],
      "scm/title": [
        {
          "command": "kdCode.generateCommitMessage",
          "when": "scmProvider == git && !kdCode.generatingCommitMessage",
          "group": "navigation@1"
        },
        {
          "command": "kdCode.cancelCommitMessage",
          "when": "scmProvider == git && kdCode.generatingCommitMessage",
          "group": "navigation@1"
        },
        {
          "command": "kdCode.commitAndPush",
          "when": "scmProvider == git",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "kdCode.cancelCommitMessage",
          "when": "kdCode.generatingCommitMessage"
        },
        {
          "command": "kdCode.quoteSelection",
          "when": "false"
        },
        {
          "command": "kdCode.pinTab",
          "when": "false"
        },
        {
          "command": "kdCode.unpinTab",
          "when": "false"
        },
        {
          "command": "kdCode.renameTab",
          "when": "false"
        },
        {
          "command": "kdCode.closeTab",
          "when": "false"
        },
        {
          "command": "kdCode.closeOtherTabs",
          "when": "false"
        },
        {
          "command": "kdCode.closeTabsBelow",
          "when": "false"
        },
        {
          "command": "kdCode.exportTab",
          "when": "false"
        },
        {
          "command": "kdCode.forkTab",
          "when": "false"
        },
        {
          "command": "kdCode.tabWorktree",
          "when": "false"
        },
        {
          "command": "kdCode.fixProblems",
          "when": "false"
        },
        {
          "command": "kdCode.explainSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "kdCode.refactorSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "kdCode.testSelection",
          "when": "editorHasSelection"
        }
      ],
      "kdCode.ask": [
        {
          "command": "kdCode.explainSelection",
          "group": "ask@0"
        },
        {
          "command": "kdCode.refactorSelection",
          "group": "ask@1"
        },
        {
          "command": "kdCode.testSelection",
          "group": "ask@2"
        }
      ],
      "webview/context": [
        {
          "command": "kdCode.quoteSelection",
          "when": "webviewId == 'kdCode.chat' && webviewSection == 'messages' && selectedText",
          "group": "kdCode@1"
        },
        {
          "command": "kdCode.pinTab",
          "when": "webviewId == 'kdCode.chat' && webviewSection == 'tab' && !tabPinned",
          "group": "1_pin@1"
        },
        {
          "command": "kdCode.unpinTab",
          "when": "webviewId == 'kdCode.chat' && webviewSection == 'tab' && tabPinned",
          "group": "1_pin@1"
        },
        {
          "command": "kdCode.renameTab",
          "when": "webviewId == 'kdCode.chat' && webviewSection == 'tab'",
          "group": "1_pin@3"
        },
        {
          "command": "kdCode.closeTab",
          "when": "webviewId == 'kdCode.chat' && webviewSection == 'tab' && !tabPinned",
          "group": "2_close@1"
        },
        {
          "command": "kdCode.closeOtherTabs",
          "when": "webviewId == 'kdCode.chat' && webviewSection == 'tab'",
          "group": "2_close@2"
        },
        {
          "command": "kdCode.closeTabsBelow",
          "when": "webviewId == 'kdCode.chat' && webviewSection == 'tab'",
          "group": "2_close@3"
        },
        {
          "command": "kdCode.forkTab",
          "when": "webviewId == 'kdCode.chat' && webviewSection == 'tab' && tabCanFork",
          "group": "1_pin@2"
        },
        {
          "command": "kdCode.tabWorktree",
          "when": "webviewId == 'kdCode.chat' && webviewSection == 'tab'",
          "group": "1_pin@4"
        },
        {
          "command": "kdCode.exportTab",
          "when": "webviewId == 'kdCode.chat' && webviewSection == 'tab'",
          "group": "1_pin@5"
        }
      ]
    },
    "configuration": {
      "title": "KD Code",
      "properties": {
        "kdCode.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "vi"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "English",
            "Tiếng Việt"
          ],
          "default": "auto",
          "description": "%config.language%"
        },
        "kdCode.customAgents": {
          "scope": "machine",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "command"
            ]
          },
          "default": {},
          "description": "%config.customAgents%"
        },
        "kdCode.env": {
          "scope": "machine",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "%config.env%"
        },
        "kdCode.providers": {
          "scope": "machine",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "hiddenModels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "modelOrder": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "favorites": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "value",
                    "name"
                  ]
                }
              }
            }
          },
          "default": {},
          "description": "%config.providers%"
        },
        "kdCode.nodePath": {
          "scope": "machine",
          "type": "string",
          "default": "node",
          "description": "%config.nodePath%"
        },
        "kdCode.ccusagePath": {
          "scope": "machine",
          "type": "string",
          "default": "",
          "description": "%config.ccusagePath%"
        },
        "kdCode.checkAgentUpdates": {
          "type": "boolean",
          "default": true,
          "description": "%config.checkAgentUpdates%"
        },
        "kdCode.followAgent": {
          "type": "boolean",
          "default": false,
          "description": "%config.followAgent%"
        },
        "kdCode.autoScroll": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoScroll%"
        },
        "kdCode.showChanges": {
          "type": "boolean",
          "default": true,
          "description": "%config.showChanges%"
        },
        "kdCode.showRestore": {
          "type": "boolean",
          "default": false,
          "description": "%config.showRestore%"
        },
        "kdCode.fontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 32,
          "description": "%config.fontSize%"
        },
        "kdCode.codeFontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 32,
          "description": "%config.codeFontSize%"
        },
        "kdCode.tracing": {
          "type": "boolean",
          "default": false,
          "description": "%config.tracing%"
        },
        "kdCode.notifications": {
          "type": "boolean",
          "default": true,
          "description": "%config.notifications%"
        },
        "kdCode.notifyFinished": {
          "type": "boolean",
          "default": true,
          "description": "%config.notifyFinished%"
        },
        "kdCode.sessionDefaults": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string"
              },
              "effort": {
                "type": "string"
              },
              "fastMode": {
                "type": "string",
                "enum": [
                  "default",
                  "on",
                  "off"
                ]
              }
            },
            "additionalProperties": false
          },
          "description": "%config.sessionDefaults%"
        },
        "kdCode.worktreeForNewTabs": {
          "type": "boolean",
          "default": false,
          "description": "%config.worktreeForNewTabs%"
        },
        "kdCode.worktreeCopyFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.worktreeCopyFiles%"
        },
        "kdCode.worktreeSetupCommand": {
          "scope": "machine",
          "type": "string",
          "default": "",
          "description": "%config.worktreeSetupCommand%"
        },
        "kdCode.worktreeProjectSetupCommand": {
          "scope": "resource",
          "type": "string",
          "default": "",
          "description": "%config.worktreeProjectSetupCommand%"
        },
        "kdCode.commitMessage.agent": {
          "type": "string",
          "default": "",
          "description": "%config.commitMessage.agent%"
        },
        "kdCode.commitMessage.model": {
          "type": "string",
          "default": "",
          "description": "%config.commitMessage.model%"
        },
        "kdCode.commitMessage.effort": {
          "type": "string",
          "default": "lowest",
          "description": "%config.commitMessage.effort%"
        },
        "kdCode.commitMessage.fastMode": {
          "type": "string",
          "enum": [
            "default",
            "on",
            "off"
          ],
          "default": "default",
          "description": "%config.commitMessage.fastMode%"
        },
        "kdCode.commitMessage.instructions": {
          "type": "string",
          "default": "Use Conventional Commits: type(scope): subject, where type is feat, fix, docs, style, refactor, perf, test, build, ci or chore and the scope is optional. Write a single subject line only, no body.",
          "editPresentation": "multilineText",
          "description": "%config.commitMessage.instructions%"
        },
        "kdCode.allowedHttpHosts": {
          "scope": "machine",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.allowedHttpHosts%"
        },
        "kdCode.autoApprove": {
          "scope": "machine",
          "type": "object",
          "default": {},
          "additionalProperties": false,
          "description": "%config.autoApprove%",
          "properties": {
            "read": {
              "type": "string",
              "enum": [
                "ask",
                "allow"
              ],
              "description": "%config.autoApprove.read%"
            },
            "edit": {
              "type": "string",
              "enum": [
                "ask",
                "allow"
              ],
              "description": "%config.autoApprove.edit%"
            },
            "execute": {
              "type": "string",
              "enum": [
                "ask",
                "allow"
              ],
              "description": "%config.autoApprove.execute%"
            },
            "fetch": {
              "type": "string",
              "enum": [
                "ask",
                "allow"
              ],
              "description": "%config.autoApprove.fetch%"
            },
            "worktreeTabs": {
              "type": "string",
              "enum": [
                "ask",
                "allow"
              ],
              "description": "%config.autoApprove.worktreeTabs%"
            }
          }
        },
        "kdCode.mcpServers": {
          "scope": "machine",
          "type": "object",
          "default": {},
          "markdownDescription": "%config.mcpServers%",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "stdio",
                  "http",
                  "sse"
                ],
                "default": "stdio"
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "url": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "install",
            "title": "%walkthrough.install.title%",
            "description": "%walkthrough.install.description%",
            "media": {
              "svg": "media/walkthrough/install.svg",
              "altText": "%walkthrough.install.alt%"
            },
            "completionEvents": [
              "onContext:kdCode.hasAgent"
            ]
          },
          {
            "id": "doctor",
            "title": "%walkthrough.doctor.title%",
            "description": "%walkthrough.doctor.description%",
            "media": {
              "svg": "media/walkthrough/doctor.svg",
              "altText": "%walkthrough.doctor.alt%"
            },
            "completionEvents": [
              "onCommand:kdCode.doctor"
            ]
          },
          {
            "id": "chat",
            "title": "%walkthrough.chat.title%",
            "description": "%walkthrough.chat.description%",
            "media": {
              "svg": "media/walkthrough/chat.svg",
              "altText": "%walkthrough.chat.alt%"
            },
            "completionEvents": [
              "onView:kdCode.chat"
            ]
          },
          {
            "id": "parallel",
            "title": "%walkthrough.parallel.title%",
            "description": "%walkthrough.parallel.description%",
            "media": {
              "svg": "media/walkthrough/parallel.svg",
              "altText": "%walkthrough.parallel.alt%"
            },
            "completionEvents": [
              "onCommand:kdCode.openSettings"
            ]
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "kdCode.chat.focus",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "kdCode.newSession",
        "key": "ctrl+shift+alt+n",
        "mac": "ctrl+cmd+n"
      },
      {
        "command": "kdCode.closeTab",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "kdCode.chatFocused || focusedView == 'kdCode.chat'"
      },
      {
        "command": "kdCode.findInConversation",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "kdCode.chatFocused || focusedView == 'kdCode.chat'"
      },
      {
        "command": "kdCode.cancel",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "kdCode.chatFocused || focusedView == 'kdCode.chat'"
      },
      {
        "command": "kdCode.addSelection",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "kdCode.addTerminalSelection",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "terminalFocus && terminalTextSelected"
      },
      {
        "command": "kdCode.addProblems",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "package": "node esbuild.mjs --production && vsce package --out release/",
    "reinstall": "npm run package && for cli in code codium; do if command -v $cli >/dev/null; then $cli --install-extension release/kd-code-$npm_package_version.vsix --force; fi; done",
    "prepare": "effect-tsgo patch --typescript --no-oxlint"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "2.4.0",
    "@effect/platform-node-shared": "4.1.0",
    "@effect/tsgo": "0.63.0",
    "@effect/vitest": "4.1.0",
    "@tabler/icons": "^3.50.0",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-document": "^3.32.1",
    "@tiptap/extension-paragraph": "^3.32.1",
    "@tiptap/extension-text": "^3.32.1",
    "@tiptap/extensions": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@types/node": "~24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.120.0",
    "@vscode/vsce": "^4.1.0",
    "effect": "4.1.0",
    "esbuild": "^0.28.2",
    "execa": "^10.2.1",
    "happy-dom": "^21.0.4",
    "pele": "1.13.0",
    "prettier": "3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
